{
  "name": "emsmediasystem",
  "version": "6.5.9",
  "description": "A simple media player",
  "main": "derived/src/main-process/main.min.mjs",
  "scripts": {
    "start": "yarn build:dev && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:slides": "node --test tests/resolved_*.test.mjs tests/song_slide_order.test.mjs tests/video_poster.test.mjs",
    "test:slides:browser": "electron --headless --no-sandbox tests/browser/resolved-measurement.electron.cjs",
    "start-paid": "yarn build:dev-paid && electron .",
    "build:dev": "make -j dev",
    "build:dev-paid": "make -j dev-paid",
    "build:source": "make -j app",
    "build:bible": "make -j bible",
    "build:bible-paid": "make -j bible-paid",
    "build:parallel": "concurrently --kill-others-on-fail --success all --names source,bible --prefix \"[{name}]\" \"make -j app\" \"make -j bible\"",
    "build:parallel-paid": "concurrently --kill-others-on-fail --success all --names source,bible --prefix \"[{name}]\" \"make -j app\" \"make -j bible-paid\"",
    "build": "make -j all",
    "build-paid": "make -j all-paid",
    "dist": "make -j all && electron-builder",
    "dist-win": "make -j all && electron-builder --win --publish=never",
    "dist-linux": "make -j all && electron-builder --linux --publish=never",
    "dist-all": "yarn build:parallel && concurrently \"electron-builder --win --publish=never\" \"electron-builder --linux --publish=never\"",
    "dist-all-paid": "yarn build:parallel-paid && concurrently \"electron-builder --win --publish=never\" \"electron-builder --linux --publish=never\"",
    "clean": "make clean"
  },
  "author": "Christian Lockley",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "csso": "^5.0.5",
    "electron": "^34.0.0",
    "electron-builder": "26.15.7",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.51.2"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "atem-connection": "^3.9.0",
    "dashjs": "^5.1.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "hls.js": "v1.7.3",
    "pdfjs-dist": "6.3.289",
    "write-file-atomic": "^7.0.1",
    "yauzl": "^3.3.2",
    "yazl": "^3.3.1",
    "youtubei.js": "^17.2.0",
    "zod": "^4.4.3"
  },
  "build": {
    "extends": "file:build-scripts/versioned-windows-installer.cjs",
    "appId": "com.ejaxmediasystem.app",
    "productName": "EMS Media System",
    "afterPack": "scripts/verify-packaged-bible-assets.cjs",
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "!src/**/*",
      "!derived/src/*.map",
      "fonts/**/*",
      "node_modules/**/*",
      "index.prod.html",
      "derived/**/*",
      "!derived/bin/**/*",
      "!derived/bible/**/*",
      "!derived/**/*.wasm",
      "!derived/src/Bible.min.mjs",
      "!derived/src/wasm_exec.min.js",
      "!sidecars/**/*",
      "!private-bibles/**/*",
      "!build-artifacts/**/*",
      "!sidecars/**/*.json",
      "!sidecars/**/*autobackup*.tsv",
      "!**/bible-imports.json",
      "!**/import-bibles.mjs",
      "!index.html",
      "!**/*.map",
      "!build-artifacts",
      "!dist"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/icon.png",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "src/main.css",
        "to": ""
      },
      {
        "from": "derived/bin",
        "to": "bin"
      },
      {
        "from": "derived/bible",
        "to": "bible"
      }
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
