{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsmediasystem.invalid/schemas/ems-theme.v1.schema.json",
  "title": "EMS Unified Theme v1",
  "type": "object",
  "required": ["schema", "id", "name", "profiles"],
  "properties": {
    "schema": { "const": "ems.theme.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "baseThemeId": { "type": ["string", "null"] },
    "tokens": { "$ref": "#/$defs/tokens" },
    "profiles": {
      "type": "object",
      "properties": {
        "song": { "$ref": "#/$defs/profileSet" },
        "scripture": { "$ref": "#/$defs/profileSet" },
        "text": { "$ref": "#/$defs/profileSet" }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "font"] },
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "name": { "type": "string" },
          "license": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "tokens": {
      "type": "object",
      "properties": {
        "fontFamily": { "type": "string" },
        "textColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "surfaceColor": { "type": "string" },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 3 }
      },
      "additionalProperties": true
    },
    "profileSet": {
      "type": "object",
      "properties": {
        "audience": { "$ref": "#/$defs/profile" },
        "lowerThird": { "$ref": "#/$defs/profile" }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "properties": {
        "typography": { "type": "object" },
        "canvas": { "type": "object" },
        "textFrame": { "type": "object" },
        "backdrop": { "type": "object" },
        "reference": { "type": "object" },
        "attribution": { "type": "object" },
        "copyright": { "type": "object" },
        "transition": { "type": "object" },
        "key": { "type": "object" },
        "placement": { "type": "object" },
        "cueLayout": { "type": "object" },
        "roles": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
